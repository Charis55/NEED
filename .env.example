# ==========================================
# NEED Platform Environment Variables Template
# Copy this file to .env.local and fill in your actual credentials.
# NEVER commit .env.local or any real secrets to Git/GitHub!
# ==========================================

# Firebase Cloud Messaging VAPID Key (Public)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Cloudflare R2 Object Storage (Server-side media upload)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
NEXT_PUBLIC_R2_PUBLIC_URL=

# Paystack Payment Gateway
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Didit Identity Verification
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=

# Resend Email Service
RESEND_API_KEY=

# Agora Real-time Audio/Video In-App Calling
NEXT_PUBLIC_AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
